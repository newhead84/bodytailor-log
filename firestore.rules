rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // [2026-07-31 신규] 문의(inquiries) 관리자 판별 헬퍼: 요청자 본인의 users/{uid} 문서에서
    // role 필드를 읽어 '관리자'인지 확인한다.
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == '관리자'
    }

    // [2026-10-31 Phase2 P2-2/P2-3] 담당 트레이너(활성 연결 + 트레이너 역할) 판정
    function isTrainerOf(memberUid) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/connections/$(request.auth.uid + '_' + memberUid)) &&
        get(/databases/$(database)/documents/connections/$(request.auth.uid + '_' + memberUid)).data.status == 'active' &&
        trainerRoleOk(get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }
    // [2026-11-02] 트레이너 역할 판정: 트레이너, 또는 트레이너 일을 켠 관리자(대표가 관리자이자 트레이너, users.trainerEnabled는 관리자만 수정)
    function trainerRoleOk(d) {
      return d.get('role', '') == '트레이너' || (d.get('role', '') == '관리자' && d.get('trainerEnabled', false) == true);
    }

    // [2026-10-31] 트레이너·관리자 판정([2026-11-01] 랭킹 읽기에서도 쓰려고 위로 옮김)
    function isStaff() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['트레이너', '관리자'];
    }

    // [2026-10-27 W0 보안강화] 본인이 자기 문서에서 권한/등급 필드를 직접 바꾸는 것을 막는다.
    // 이전에는 본인 문서 전체 쓰기를 허용해 role:'관리자'를 스스로 넣으면 isAdmin()을 통과하는
    // 권한 상승이 가능했다. role/roleRequestStatus/tier/lifetimeBadges/trainerProfile은
    // 콘솔(관리자) 또는 추후 서버 로직에서만 변경한다.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // [2026-10-31 Phase2 P2-1] 헬스장 회원 승인 필드(memberStatus 등)도 본인은 변경 불가 - 관리자만
    function lockedUserKeys() {
      return ['role', 'roleRequestStatus', 'tier', 'lifetimeBadges', 'trainerProfile',
        'memberStatus', 'approvedAt', 'approvedBy', 'memberNo', 'rosterId', 'statusUpdatedAt',
        'membershipStart', 'membershipEnd', 'membershipEndAt', 'ptTotal', 'ptRemaining', 'ptUpdatedAt', 'pauseStart', 'pauseEnd',
        // [2026-11-01] 휴회 이력(pauses)·PT 차감 짝 기록(ptSessionRef)도 본인 수정 불가
        'pauses', 'ptSessionRef',
        // [2026-11-02] 관리자 겸 트레이너 표시
        'trainerEnabled',
        // [2026-11-01] B20: PT 일정 변경 알림 표시는 담당 트레이너만 쓴다
        'ptLastChange'];
    }
    // [2026-10-31] 트레이너 목표 쓰기 값 검사(바뀐 필드만): 목표 8개 이하, 주 1~7일, 제안·표시는 본인 uid
    function goalListOk(g) {
      return g is list && g.size() <= 8;
    }
    function daysOk(d) {
      return d is int && d >= 1 && d <= 7;
    }
    function nameOk(n) {
      return n is string && n.size() <= 30;
    }
    // [2026-11-01] S14: 제안·수정 표시는 필드 화이트리스트 + 이름 30자 + 서버 시각(at == request.time)
    function trainerGoalOk() {
      let d = request.resource.data;
      let keys = d.diff(resource.data).affectedKeys();
      return (!keys.hasAny(['onboarding']) || goalListOk(d.onboarding.goals)) &&
        (!keys.hasAny(['weeklyTargetDays']) || daysOk(d.weeklyTargetDays)) &&
        (!keys.hasAny(['goalProposal']) || d.goalProposal == null ||
          (d.goalProposal.keys().hasOnly(['goals', 'weeklyTargetDays', 'byUid', 'byName', 'at']) &&
            d.goalProposal.byUid == request.auth.uid && nameOk(d.goalProposal.get('byName', '')) &&
            d.goalProposal.at == request.time &&
            goalListOk(d.goalProposal.goals) && daysOk(d.goalProposal.weeklyTargetDays))) &&
        (!keys.hasAny(['goalByTrainer']) || d.goalByTrainer == null ||
          (d.goalByTrainer.keys().hasOnly(['byUid', 'byName', 'at', 'seen', 'accepted']) &&
            d.goalByTrainer.byUid == request.auth.uid && nameOk(d.goalByTrainer.get('byName', '')) &&
            d.goalByTrainer.at == request.time &&
            d.goalByTrainer.get('seen', false) == false && d.goalByTrainer.get('accepted', false) == false)) &&
        // [2026-11-01] B23: 트레이너는 거절 결과 표시를 지우기만(새 제안을 보낼 때)
        (!keys.hasAny(['goalProposalResult']) || d.goalProposalResult == null);
    }
    // [2026-11-01] S13: 회원 본인의 목표 표시 쓰기 - 제안은 지우기만, 수정 표시는 지우기·확인(seen)·제안 수락(제안한 트레이너 그대로)만
    function ownerGoalOk(d, o, keys) {
      return (!keys.hasAny(['goalProposal']) || d.goalProposal == null) &&
        (!keys.hasAny(['goalByTrainer']) || d.goalByTrainer == null ||
          (o.get('goalByTrainer', null) != null &&
            d.goalByTrainer.diff(o.goalByTrainer).affectedKeys().hasOnly(['seen']) && d.goalByTrainer.seen == true) ||
          (o.get('goalProposal', null) != null &&
            d.goalByTrainer.keys().hasOnly(['byUid', 'byName', 'at', 'seen', 'accepted']) &&
            d.goalByTrainer.byUid == o.goalProposal.byUid &&
            d.goalByTrainer.get('byName', '') == o.goalProposal.get('byName', '') &&
            d.goalByTrainer.at == request.time && d.goalByTrainer.accepted == true)) &&
        // [2026-11-01] B23: 받은 제안을 거절할 때만 거절 결과(트레이너가 볼 표시)를 남긴다. 지우기는 언제나 가능
        (!keys.hasAny(['goalProposalResult']) || d.goalProposalResult == null ||
          (o.get('goalProposal', null) != null && d.get('goalProposal', null) == null &&
            d.goalProposalResult.keys().hasOnly(['declined', 'at', 'byUid', 'byName']) &&
            d.goalProposalResult.declined == true && d.goalProposalResult.at == request.time &&
            d.goalProposalResult.byUid == o.goalProposal.byUid));
    }
    // [2026-11-01] S6: 본인은 예전 위치(users.signupInfo.phoneHash)의 번호 변환값을 지우는 것만 승인 후에도 할 수 있다(memberPrivate로 옮김)
    function phoneHashDropOk(d, o) {
      return o.get('signupInfo', null) is map && d.get('signupInfo', null) is map &&
        d.signupInfo.diff(o.signupInfo).affectedKeys().hasOnly(['phoneHash']) && !('phoneHash' in d.signupInfo);
    }
    // [2026-11-01] B20: PT 일정 등록·변경 알림 표시(서버 시각, 종류 3가지)
    function ptChangeOk(d) {
      return d.ptLastChange is map && d.ptLastChange.keys().hasOnly(['at', 'kind']) &&
        d.ptLastChange.at == request.time && d.ptLastChange.kind in ['new', 'change', 'cancel'];
    }
    // [2026-11-08] 신체 지표(선택): 허리둘레·체지방률·골격근량은 범위 안 숫자, 인바디 측정일은 'YYYY-MM-DD'
    function optNumIn(o, k, lo, hi) {
      return !(k in o) || o[k] == null || (o[k] is number && o[k] >= lo && o[k] <= hi);
    }
    function bodyCompOk(o) {
      return optNumIn(o, 'waistCm', 40, 200) && optNumIn(o, 'bodyFatPct', 3, 60) && optNumIn(o, 'smmKg', 5, 80) &&
        (!('inbodyAt' in o) || o.inbodyAt == null || (o.inbodyAt is string && o.inbodyAt.size() == 10));
    }
    // [2026-11-01] S10·S21: 본인 users 쓰기 값 검사(keys = 쓰는 필드만 검사해 기존 문서는 그대로 통과)
    function userFieldsOk(d, keys) {
      return (!keys.hasAny(['nickname']) || nameOk(d.nickname)) &&
        (!keys.hasAny(['onboarding']) || d.onboarding == null ||
          (d.onboarding is map && d.onboarding.keys().size() <= 20 && goalListOk(d.onboarding.get('goals', [])) && bodyCompOk(d.onboarding))) &&
        (!keys.hasAny(['signupInfo']) ||
          (d.signupInfo is map && d.signupInfo.keys().hasOnly(['name', 'phoneHash', 'phoneLast4']) &&
            nameOk(d.signupInfo.get('name', '')) &&
            d.signupInfo.get('phoneHash', '') is string && d.signupInfo.get('phoneHash', '').size() <= 64 &&
            d.signupInfo.get('phoneLast4', '') is string && d.signupInfo.get('phoneLast4', '').size() <= 4)) &&
        (!keys.hasAny(['activity']) ||
          (d.activity is map && d.activity.keys().hasOnly(['lastDate', 'lastParts', 'weeks']) &&
            d.activity.get('lastDate', '') is string && d.activity.get('lastDate', '').size() <= 10 &&
            d.activity.get('lastParts', []) is list && d.activity.get('lastParts', []).size() <= 8 &&
            d.activity.get('weeks', {}) is map && d.activity.get('weeks', {}).size() <= 12)) &&
        (!keys.hasAny(['prs']) || (d.prs is map && d.prs.size() <= 400)) &&
        (!keys.hasAny(['exerciseSettings']) || (d.exerciseSettings is map && d.exerciseSettings.size() <= 400)) &&
        // [2026-11-02] 로그 코치 전체 강도
        (!keys.hasAny(['coachIntensity']) || d.coachIntensity in ['easy2', 'easy', 'normal', 'hard', 'max']) &&
        (!keys.hasAny(['coachEnabled']) || d.coachEnabled is bool) &&
        // [2026-11-08] 완료 효과음 켜기·끄기
        (!keys.hasAny(['sfxEnabled']) || d.sfxEnabled is bool) &&
        // [2026-11-09] 소리 크기·진동 세기(0–100 정수)
        (!keys.hasAny(['alertVolume']) || (d.alertVolume is int && d.alertVolume >= 0 && d.alertVolume <= 100)) &&
        (!keys.hasAny(['vibrationLevel']) || (d.vibrationLevel is int && d.vibrationLevel >= 0 && d.vibrationLevel <= 100)) &&
        // [2026-11-07] 로그 코치 프로그램 답(질문 답 12개 이하)
        (!keys.hasAny(['coachProgram']) || (d.coachProgram is map && d.coachProgram.keys().hasOnly(['v', 'answers', 'at']) &&
          d.coachProgram.get('answers', {}) is map && d.coachProgram.get('answers', {}).size() <= 12)) &&
        (!keys.hasAny(['customExercises']) || (d.customExercises is map && d.customExercises.size() <= 12)) &&
        // [2026-11-11] 체중 기록(날짜별, 최대 120개)
        (!keys.hasAny(['weightLog']) || (d.weightLog is list && d.weightLog.size() <= 120)) &&
        // [2026-11-12] 식단 제안 취향(안 먹는 것은 취향 태그만, 체중 보정 ±300kcal)
        (!keys.hasAny(['diet']) || (d.diet is map &&
          d.diet.keys().hasOnly(['v', 'style', 'meals', 'activity', 'cookMin', 'avoid', 'adj', 'adjAt', 'plateauAskedAt']) &&
          d.diet.get('style', 'easy') in ['easy', 'mix', 'cook'] &&
          d.diet.get('meals', 4) in [2, 3, 4, 5] &&
          d.diet.get('activity', 'sit') in ['sit', 'move'] &&
          d.diet.get('cookMin', 15) in [5, 15, 30] &&
          d.diet.get('avoid', []) is list && d.diet.get('avoid', []).size() <= 10 &&
          d.diet.get('adj', 0) is int && d.diet.get('adj', 0) >= -300 && d.diet.get('adj', 0) <= 300 &&
          d.diet.get('adjAt', 0) is int && d.diet.get('plateauAskedAt', 0) is int)) &&
        // [2026-11-13] 즐겨찾는 운동(이름)·식단(메뉴 id) 각 60개 이하
        (!keys.hasAny(['favExercises']) || (d.favExercises is list && d.favExercises.size() <= 60)) &&
        (!keys.hasAny(['favMeals']) || (d.favMeals is list && d.favMeals.size() <= 60)) &&
        // S3: 문의 간격 기록은 서버 시각으로만
        (!keys.hasAny(['lastInquiryAt']) || d.lastInquiryAt == request.time);
    }
    // 관리자가 다른 회원 문서에서 바꿀 수 있는 필드
    function adminUserKeys() {
      return ['role', 'memberStatus', 'approvedAt', 'approvedBy', 'memberNo', 'rosterId', 'statusUpdatedAt',
        'membershipStart', 'membershipEnd', 'membershipEndAt', 'ptTotal', 'ptRemaining', 'ptUpdatedAt', 'pauseStart', 'pauseEnd',
        // [2026-11-01] 휴회 이력, 재심사 요청 처리(해제)
        'pauses', 'reReviewRequested', 'reReviewAt',
        // [2026-11-01] B10: 승인 후 이름·휴대폰 뒤 4자리 정정(번호 변환값은 memberPrivate)
        'signupInfo',
        // [2026-11-02] 관리자 겸 트레이너 표시(관리자 계정에만 의미)
        'trainerEnabled'];
    }
    // [2026-10-31 Phase2 P2-1] 승인된 회원만 기록·루틴·랭킹을 쓸 수 있다.
    // memberStatus가 없는 기존 계정은 승인으로 간주, 관리자는 항상 허용.
    function isApproved() {
      let d = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      // [2026-10-31] 회원권 종료일(membershipEndAt)이 지나면 쓰기 불가 - 트레이너·관리자 예외, 종료일 없으면 제한 없음
      return request.auth != null && (d.get('role', '') == '관리자' ||
        (d.get('memberStatus', 'approved') == 'approved' &&
          (d.get('role', '') == '트레이너' || d.get('membershipEndAt', null) == null || request.time <= d.membershipEndAt)));
    }
    function ptDeductEnabled() {
      return get(/databases/$(database)/documents/settings/app).data.get('ptDeductEnabled', false) == true;
    }
    // 세션 1회 XP 상한(storage.js computeSessionXp 최대 175) - 여유분 포함 200
    // [2026-10-29] 자동 저장 "되돌리기"로 XP를 빼야 해서 감소도 1회 200까지 허용(0 미만 불가).
    function xpDeltaOk(field) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is number &&
         request.resource.data[field] >= 0 &&
         request.resource.data[field] - resource.data.get(field, 0) >= -200 &&
         request.resource.data[field] - resource.data.get(field, 0) <= 200);
    }
    // [2026-11-01] S4: XP가 늘어나는 쓰기는 xpAt == 서버 시각이고 직전 xpAt에서 2분이 지나야 한다.
    // 줄어드는 쓰기(자동 저장 되돌리기)는 xpAt 없이 가능. xpAt을 쓸 때는 항상 서버 시각.
    function xpTimeOk() {
      let d = request.resource.data;
      let o = resource.data;
      let up = d.get('lifetimeXp', 0) > o.get('lifetimeXp', 0) || d.get('seasonXp', 0) > o.get('seasonXp', 0);
      return (!d.diff(o).affectedKeys().hasAny(['xpAt']) || d.xpAt == request.time) &&
        (!up || (d.get('xpAt', null) == request.time &&
          (o.get('xpAt', null) == null || request.time > o.xpAt + duration.value(2, 'm'))));
    }
    // [2026-11-01] 재심사 요청(거절된 회원이 정보를 고친 뒤): 거절 상태에서만 본인이 쓸 수 있고 시각은 서버 시각
    function reReviewOk(d, o, keys) {
      return (!keys.hasAny(['reReviewRequested']) ||
          (o.get('memberStatus', 'approved') == 'rejected' && d.reReviewRequested is bool)) &&
        (!keys.hasAny(['reReviewAt']) || (o.get('memberStatus', 'approved') == 'rejected' && d.reReviewAt == request.time));
    }
    // 시즌이 바뀐 첫 저장에서는 seasonXp가 새 시즌 값(0~200)으로 리셋될 수 있다.
    function seasonXpOk() {
      return xpDeltaOk('seasonXp') ||
        (request.resource.data.get('seasonKey', null) != resource.data.get('seasonKey', null) &&
         request.resource.data.seasonXp is number &&
         request.resource.data.seasonXp >= 0 && request.resource.data.seasonXp <= 200);
    }

    // users/{uid} - 본인 문서만 읽기/쓰기(권한 필드·XP 증가폭 제한)
    // [2026-10-31 Phase2 P2-1] 관리자는 전체 회원 읽기 + 승인·역할 필드만 수정. 새 계정은 승인 대기(pending)로만 생성.
    match /users/{uid} {
      // [2026-10-31] 담당 트레이너도 회원 문서(신체정보·목표 포함)를 읽는다 - PT 회원 신체정보 트레이너 공유(설계 7.x 권한 체계)
      allow read: if isOwner(uid) || isAdmin() || isTrainerOf(uid);
      allow create: if isOwner(uid) &&
        request.resource.data.get('role', '일반회원') == '일반회원' &&
        request.resource.data.get('roleRequestStatus', 'none') == 'none' &&
        // [2026-11-13] 일반형(settings/app.appMode == 'open')이면 가입과 동시에 승인 상태로 만들 수 있다
        (request.resource.data.get('memberStatus', '') == 'pending' ||
          (request.resource.data.get('memberStatus', '') == 'approved' && openSignupOk())) &&
        request.resource.data.get('tier', 'iron') == 'iron' &&
        request.resource.data.get('lifetimeBadges', []).size() == 0 &&
        request.resource.data.get('trainerProfile', null) == null &&
        !request.resource.data.keys().hasAny(['approvedAt', 'approvedBy', 'memberNo', 'rosterId', 'statusUpdatedAt',
          'membershipStart', 'membershipEnd', 'membershipEndAt', 'ptTotal', 'ptRemaining', 'ptUpdatedAt', 'pauseStart', 'pauseEnd',
          'pauses', 'ptSessionRef', 'xpAt', 'lastInquiryAt', 'reReviewRequested', 'reReviewAt', 'goalProposal', 'goalByTrainer',
          'goalProposalResult', 'ptLastChange', 'trainerEnabled']) &&
        userFieldsOk(request.resource.data, request.resource.data.keys()) &&
        request.resource.data.get('seasonXp', 0) == 0 &&
        request.resource.data.get('lifetimeXp', 0) == 0 &&
        // [2026-10-31] 탈퇴 표시가 있는 uid는 다시 만들 수 없다(users만 지웠다 재생성해 거절·만료·회원권 필드를 초기화하는 우회 방지)
        !exists(/databases/$(database)/documents/deletedAccounts/$(uid));
      // signupInfo(이름·휴대폰 변환값)는 승인 대기·거절 상태이거나 아직 없을 때(기존 계정 첫 입력)만 본인이 쓸 수 있다(승인 후엔 관리자 대조 기준이라 잠금).
      allow update: if (isOwner(uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(lockedUserKeys()) &&
          userFieldsOk(request.resource.data, request.resource.data.diff(resource.data).affectedKeys()) &&
          ownerGoalOk(request.resource.data, resource.data, request.resource.data.diff(resource.data).affectedKeys()) &&
          reReviewOk(request.resource.data, resource.data, request.resource.data.diff(resource.data).affectedKeys()) &&
          xpTimeOk() &&
          (resource.data.get('memberStatus', 'approved') in ['pending', 'rejected'] || !('signupInfo' in resource.data) ||
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['signupInfo']) ||
            phoneHashDropOk(request.resource.data, resource.data)) &&
          seasonXpOk() && xpDeltaOk('lifetimeXp') &&
          // [2026-10-31] XP는 승인된(회원권 유효) 회원만 바꿀 수 있다 - 대기·만료 계정의 XP 부풀리기 방지
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['seasonXp', 'lifetimeXp', 'seasonKey', 'xpAt']) || isApproved())) ||
        (isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(adminUserKeys()) &&
          request.resource.data.get('role', '일반회원') in ['일반회원', 'PT회원', '트레이너', '관리자'] &&
          request.resource.data.get('memberStatus', 'approved') in ['pending', 'approved', 'rejected', 'expired'] &&
          (uid != request.auth.uid || request.resource.data.get('role', '') == '관리자')) ||
        // [2026-10-31] 담당 트레이너의 PT 1회 차감·되돌리기(설정에서 켠 경우만, ±1, 0~총 횟수)
        // [2026-11-01] S1: 같은 일괄 쓰기에서 ptSessions/{ptSessionRef}를 만들 때만 -1, 지울 때만 +1(기록 없는 차감·차감 없는 기록 방지)
        // [2026-11-01] 바뀐 필드 검사를 앞에 두어 해당 없는 쓰기에서 get() 호출을 줄인다(호출 수 한도)
        // [2026-11-01] 미결제(unpaid) 기록으로는 차감·되돌리기를 하지 못한다(횟수 임의 증감 방지)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ptRemaining', 'ptUpdatedAt', 'ptSessionRef']) &&
          isTrainerOf(uid) && ptDeductEnabled() &&
          request.resource.data.ptRemaining is int &&
          request.resource.data.ptSessionRef is string && request.resource.data.ptSessionRef.size() > 0 &&
          ((request.resource.data.ptRemaining == resource.data.get('ptRemaining', 0) - 1 &&
              !exists(/databases/$(database)/documents/ptSessions/$(request.resource.data.ptSessionRef)) &&
              existsAfter(/databases/$(database)/documents/ptSessions/$(request.resource.data.ptSessionRef)) &&
              getAfter(/databases/$(database)/documents/ptSessions/$(request.resource.data.ptSessionRef)).data.memberUid == uid &&
              getAfter(/databases/$(database)/documents/ptSessions/$(request.resource.data.ptSessionRef)).data.trainerUid == request.auth.uid &&
              getAfter(/databases/$(database)/documents/ptSessions/$(request.resource.data.ptSessionRef)).data.get('unpaid', false) == false) ||
            (request.resource.data.ptRemaining == resource.data.get('ptRemaining', 0) + 1 &&
              exists(/databases/$(database)/documents/ptSessions/$(request.resource.data.ptSessionRef)) &&
              !existsAfter(/databases/$(database)/documents/ptSessions/$(request.resource.data.ptSessionRef)) &&
              get(/databases/$(database)/documents/ptSessions/$(request.resource.data.ptSessionRef)).data.memberUid == uid &&
              get(/databases/$(database)/documents/ptSessions/$(request.resource.data.ptSessionRef)).data.trainerUid == request.auth.uid &&
              get(/databases/$(database)/documents/ptSessions/$(request.resource.data.ptSessionRef)).data.get('unpaid', false) == false)) &&
          request.resource.data.ptRemaining >= 0 &&
          request.resource.data.ptRemaining <= resource.data.get('ptTotal', 0)) ||
        // [2026-10-31] 담당 트레이너의 목표 제안·직접 수정 - 목표(onboarding.goals)·주간 목표·제안·수정 표시만
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['onboarding', 'weeklyTargetDays', 'goalProposal', 'goalByTrainer', 'goalProposalResult']) &&
          isTrainerOf(uid) &&
          // [2026-11-01] onboarding이 null로 저장된 문서도 빈 맵으로 비교
          (request.resource.data.get('onboarding', null) == null ? {} : request.resource.data.onboarding).diff(resource.data.get('onboarding', null) == null ? {} : resource.data.onboarding).affectedKeys().hasOnly(['goals']) &&
          trainerGoalOk()) ||
        // [2026-11-01] B20: 담당 트레이너가 PT 일정을 등록·변경·취소할 때 회원 HOME 알림 표시(ptLastChange)만
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ptLastChange']) &&
          isTrainerOf(uid) && ptChangeOk(request.resource.data));
      // [2026-10-31] 계정 삭제(탈퇴) - 탈퇴 표시(deletedAccounts/{uid})를 먼저 남긴 본인만 삭제. 같은 uid는 다시 만들 수 없고,
      // 같은 구글 계정으로 다시 가입하면 로그인 계정 삭제 후라 새 uid(승인 대기)로 시작한다.
      allow delete: if isOwner(uid) && exists(/databases/$(database)/documents/deletedAccounts/$(uid));
    }
    // [2026-10-31] 탈퇴 표시 - 본인만 생성(삭제 시각만), 수정·삭제 불가. 개인정보 없음(uid만).
    match /deletedAccounts/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.keys().hasOnly(['deletedAt']) &&
        request.resource.data.get('deletedAt', null) == request.time;
      allow update, delete: if false;
    }

    // [2026-11-01] S6: 휴대폰 번호 변환값(phoneHash)은 users 문서(담당 트레이너도 읽음)에서 빼서 본인·관리자만 읽는 문서로.
    // 본인 쓰기: 승인 대기·거절 상태이거나, 처음 만들 때(예전 users 문서의 값을 옮기는 경우 같은 값만). 삭제는 탈퇴 표시 뒤 본인·관리자.
    function privOk() {
      return request.resource.data.keys().hasOnly(['phoneHash', 'updatedAt']) &&
        request.resource.data.phoneHash is string && request.resource.data.phoneHash.size() <= 64;
    }
    function privOwnerOk(uid) {
      let u = get(/databases/$(database)/documents/users/$(uid)).data;
      return u.get('memberStatus', 'approved') in ['pending', 'rejected'] ||
        (resource == null &&
          (u.get('signupInfo', {}).get('phoneHash', '') == '' || u.signupInfo.phoneHash == request.resource.data.phoneHash));
    }
    match /memberPrivate/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if (isOwner(uid) && privOk() && privOwnerOk(uid)) || (isAdmin() && privOk());
      allow delete: if isAdmin() || (isOwner(uid) && exists(/databases/$(database)/documents/deletedAccounts/$(uid)));
    }

    // [2026-10-31 Phase2 P2-1] gymRoster/{rosterId} - 헬스장 출입관리 명단 이관본(이름·전화 해시·뒤 4자리·회원번호·만료일). 관리자만.
    match /gymRoster/{rosterId} {
      allow read, write: if isAdmin();
    }

    // routineTemplates/{uid}/templates/{templateId} - 본인 소유 서브컬렉션
    // [2026-10-31 P2-3] 담당 트레이너는 회원 루틴을 읽고, 자기 이름(byTrainer.uid)으로 만든 계획만 생성·수정·삭제한다.
    function trainerPlanOk() {
      return request.resource.data.keys().hasOnly(['title', 'parts', 'note', 'byTrainer', 'trainerRx', 'order', 'createdAt', 'updatedAt']) &&
        // [2026-11-07] 트레이너 처방(종목별 세트·횟수·강도, 종목 80개 이하 - 값은 앱이 읽을 때 정리)
        (request.resource.data.get('trainerRx', {}) is map && request.resource.data.get('trainerRx', {}).size() <= 80) &&
        request.resource.data.byTrainer.keys().hasOnly(['uid', 'name']) &&
        request.resource.data.byTrainer.uid == request.auth.uid &&
        request.resource.data.title is string && request.resource.data.title.size() <= 40 &&
        request.resource.data.parts is list && request.resource.data.parts.size() <= 7 &&
        // [2026-11-01] S15: 파트별 종목 40개 이하(파트 7개까지 하나씩 검사), 트레이너 이름 30자
        planPartOk(request.resource.data.parts, 0) && planPartOk(request.resource.data.parts, 1) &&
        planPartOk(request.resource.data.parts, 2) && planPartOk(request.resource.data.parts, 3) &&
        planPartOk(request.resource.data.parts, 4) && planPartOk(request.resource.data.parts, 5) &&
        planPartOk(request.resource.data.parts, 6) &&
        nameOk(request.resource.data.byTrainer.get('name', '')) &&
        request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 300;
    }
    function planPartOk(parts, i) {
      return parts.size() <= i ||
        (parts[i] is map && parts[i].get('exercises', []) is list && parts[i].get('exercises', []).size() <= 40);
    }
    // [2026-11-01] S10: 본인 루틴 크기 제한(쓰는 필드만 검사) - 제목 60자, 파트 20개
    function ownRoutineOk(d, keys) {
      return (!keys.hasAny(['title']) || (d.title is string && d.title.size() <= 60)) &&
        (!keys.hasAny(['parts']) || (d.parts is list && d.parts.size() <= 20)) &&
        // [2026-11-07] 로그 코치 프로그램 처방(종목 80개 이하)·표시
        (!keys.hasAny(['coachRx']) || (d.coachRx is map && d.coachRx.size() <= 80)) &&
        (!keys.hasAny(['byCoach']) || d.byCoach is map);
    }
    match /routineTemplates/{uid}/templates/{templateId} {
      allow read: if request.auth != null && (request.auth.uid == uid || isTrainerOf(uid));
      // 본인은 byTrainer(트레이너 계획 표시)를 새로 넣거나 바꿀 수 없다(가짜 트레이너 배지 방지). 삭제·나머지 수정은 가능.
      // [2026-11-07] 트레이너 처방(trainerRx)도 회원이 넣거나 바꿀 수 없다(트레이너 처방 > 로그 코치)
      allow create: if isOwner(uid) && isApproved() && !('byTrainer' in request.resource.data) && !('trainerRx' in request.resource.data) &&
        ownRoutineOk(request.resource.data, request.resource.data.keys());
      allow update: if isOwner(uid) && isApproved() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['byTrainer', 'trainerRx']) &&
        ownRoutineOk(request.resource.data, request.resource.data.diff(resource.data).affectedKeys());
      // [2026-10-31] 삭제는 승인 여부와 관계없이 본인 가능(탈퇴·대기·만료 계정 정리)
      allow delete: if isOwner(uid);
      allow create: if isTrainerOf(uid) && trainerPlanOk();
      allow update: if isTrainerOf(uid) && resource.data.get('byTrainer', {}).get('uid', '') == request.auth.uid && trainerPlanOk();
      allow delete: if isTrainerOf(uid) && resource.data.get('byTrainer', {}).get('uid', '') == request.auth.uid;
    }

    // [2026-11-07] 체력 점검(선택): 본인 쓰기, 본인·담당 트레이너 읽기(신체 정보와 같은 범위)
    function fitnessTestOk(d) {
      return d.keys().hasOnly(['date', 'hangSec', 'wallSitSec', 'carryKg', 'carrySec', 'sitRise', 'gripKg', 'cooperM', 'createdAt']) &&
        d.date is string && d.date.size() == 10 &&
        numIn(d.get('hangSec', 0), 0, 1200) && numIn(d.get('wallSitSec', 0), 0, 1200) &&
        numIn(d.get('carryKg', 0), 0, 200) && numIn(d.get('carrySec', 0), 0, 1200) &&
        numIn(d.get('sitRise', 0), 0, 10) && numIn(d.get('gripKg', 0), 0, 150) && numIn(d.get('cooperM', 0), 0, 6000);
    }
    function numIn(v, lo, hi) {
      return v == null || ((v is int || v is float) && v >= lo && v <= hi);
    }
    match /fitnessTests/{uid}/tests/{testId} {
      allow read: if request.auth != null && (request.auth.uid == uid || isTrainerOf(uid));
      allow create, update: if isOwner(uid) && isApproved() && fitnessTestOk(request.resource.data);
      allow delete: if isOwner(uid);
    }

    // [2026-10-27 신규] activeSessions/{uid} - 진행 중 운동 세션 서버 백업(본인만, 크기 제한)
    match /activeSessions/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isApproved() &&
        request.resource.data.keys().hasOnly(['draft', 'updatedAt']) &&
        request.resource.data.draft is string && request.resource.data.draft.size() < 200000;
    }

    // workoutLogs/{uid}/logs/{logId} - 본인 소유 서브컬렉션
    // [2026-10-31 Phase2 P2-2] 담당 트레이너(isTrainerOf)는 그 회원의 운동 기록을 읽을 수 있다(쓰기 불가).
    match /workoutLogs/{uid}/logs/{logId} {
      allow read: if request.auth != null && (request.auth.uid == uid || isTrainerOf(uid));
      // [2026-11-01] S10: 종목 60개 이하(쓰는 경우만 검사)
      allow create: if request.auth != null && request.auth.uid == uid && isApproved() &&
        (!('exercises' in request.resource.data) ||
          (request.resource.data.exercises is list && request.resource.data.exercises.size() <= 60));
      allow update: if request.auth != null && request.auth.uid == uid && isApproved() &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['exercises']) ||
          (request.resource.data.exercises is list && request.resource.data.exercises.size() <= 60));
      // [2026-10-31] 삭제는 승인 여부와 관계없이 본인 가능(탈퇴·만료 후 기록 정리)
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // leaderboard/{group}/{period}/{uid}
    // 랭킹은 로그인한 모든 사용자가 열람 가능(전체 랭킹 노출 목적),
    // 쓰기는 본인 문서만 허용. 부정 점수 조작 방지가 중요해지면
    // 이 쓰기 권한은 Cloud Functions 전용으로 옮기고 클라이언트 쓰기를 막는 것을 권장.
    // [2026-10-27 W0] 필드 화이트리스트 + 점수 범위(0~200) 검증. 완전한 조작 방지는 서버 계산이
    // 필요하지만(무료 플랜 유지 결정), 비정상 값(예: 99999점) 기록은 규칙에서 거부한다.
    function scoreOk(k) {
      return !(k in request.resource.data) ||
        (request.resource.data[k] is number && request.resource.data[k] >= 0 && request.resource.data[k] <= 200);
    }
    // [2026-11-01] S5: 점수 공식 검사(scoring.js computeFinalScore = 출석 0.4 + 볼륨 0.3 + 과부하 0.3 + 연속 보너스, 반올림 오차 1)
    function pctOk(v) {
      return v is number && v >= 0 && v <= 100;
    }
    function lbFormulaOk() {
      let d = request.resource.data;
      let a = d.get('attendanceScore', 0);
      let v = d.get('volumeScore', 0);
      let o = d.get('overloadScore', 0);
      let s = d.get('streakBonus', 0);
      let p = d.get('programComplianceBonus', 0);
      let f = d.get('finalScore', 0);
      return pctOk(a) && pctOk(v) && pctOk(o) &&
        s is number && s >= 0 && s <= 20 &&
        p is number && p >= 0 && p <= 5 &&
        f is number && f <= 125 &&
        math.abs(f - (a * 0.4 + v * 0.3 + o * 0.3 + s + p)) <= 1;
    }
    match /leaderboard/{group}/{period}/{uid} {
      // [2026-11-01] S17: 승인 회원(회원권 유효)·트레이너·관리자만 읽기
      allow read: if request.auth != null && (isApproved() || isStaff());
      // [2026-10-31] 탈퇴 시 내 랭킹 기록 삭제, [2026-11-01] B28: 관리자는 지난 시즌 랭킹 정리
      allow delete: if isOwner(uid) || isAdmin();
      // [2026-11-01] S5: 그룹은 'all', 기간은 season-YYYY-Q 형식만
      allow create, update: if isOwner(uid) && isApproved() &&
        group == 'all' && period.matches('^season-[0-9]{4}-[1-4]$') &&
        lbFormulaOk() &&
        request.resource.data.keys().hasOnly(['nickname', 'baseScore', 'attendanceScore', 'volumeScore',
          'overloadScore', 'streakBonus', 'programComplianceBonus', 'finalScore', 'updatedAt']) &&
        // [2026-10-31] 닉네임은 가린 형태(첫 글자 + * 1~3개)만 저장 - 다른 회원이 원래 닉네임을 읽지 못하게
        (!('nickname' in request.resource.data) ||
          (request.resource.data.nickname is string &&
            (request.resource.data.nickname.matches('^.[*]{1,3}$') || request.resource.data.nickname == '회원'))) &&
        scoreOk('baseScore') && scoreOk('attendanceScore') && scoreOk('volumeScore') &&
        scoreOk('overloadScore') && scoreOk('streakBonus') && scoreOk('programComplianceBonus') &&
        scoreOk('finalScore');
    }

    // exercisePopularity/{atom} - 개인정보 없는 부위별 종목 수행 횟수 공개 집계(⑨).
    // 로그인한 모든 사용자가 열람 가능(리포트 탭 "다른 유저 즐겨찾는 운동" 노출 목적).
    // 쓰기(카운트 증가)도 로그인 사용자면 가능 - 개인 식별 정보가 없는 집계 수치라
    // leaderboard처럼 본인 uid로 제한할 필요가 없다. 악의적 대량 조작 우려가 커지면
    // Cloud Functions 전용 쓰기로 옮기는 것을 권장(leaderboard와 동일한 원칙).
    // [2026-10-27 W0] counts 맵 외 필드 쓰기 금지 + 한 번에 바뀌는 종목 수 제한, 삭제 금지.
    // [2026-11-01] S2: 한 번 쓰기에 바뀌는 종목은 names(최대 8개)에 적은 것만, 각 값은 정수로 1~30 증가(감소·덮어쓰기 불가)
    function popIncOk(c, o, names, i) {
      return names.size() <= i ||
        (names[i] is string && names[i].size() >= 1 && names[i].size() <= 40 &&
          c[names[i]] is int && c[names[i]] - o.get(names[i], 0) >= 1 && c[names[i]] - o.get(names[i], 0) <= 30);
    }
    function popOk(c, o, names) {
      return c is map && names is list && names.size() >= 1 && names.size() <= 8 &&
        c.diff(o).affectedKeys().hasOnly(names) &&
        popIncOk(c, o, names, 0) && popIncOk(c, o, names, 1) && popIncOk(c, o, names, 2) && popIncOk(c, o, names, 3) &&
        popIncOk(c, o, names, 4) && popIncOk(c, o, names, 5) && popIncOk(c, o, names, 6) && popIncOk(c, o, names, 7);
    }
    match /exercisePopularity/{atom} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isApproved() && request.resource.data.keys().hasOnly(['counts', 'names']) &&
        popOk(request.resource.data.get('counts', {}), {}, request.resource.data.get('names', []));
      allow update: if request.auth != null && isApproved() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counts', 'names']) &&
        popOk(request.resource.data.get('counts', {}), resource.data.get('counts', {}), request.resource.data.get('names', []));
      allow delete: if false;
    }

    // inquiries/{inquiryId} - MY탭 1:1 문의(⑩). 본인은 작성 + 본인 문의만 열람 가능.
    // 관리자(role === '관리자')는 전체 열람 + 답변(reply/status) 수정 가능. uid/content는
    // 작성자 본인도 수정 불가(문의 내용 위변조 방지, 답변만 관리자가 갱신).
    match /inquiries/{inquiryId} {
      // [2026-11-01] S3·S9: 가입한(users 문서 있는) 본인만, 필드 화이트리스트, 작성 시각은 서버 시각,
      // 같은 일괄 쓰기에서 users.lastInquiryAt을 서버 시각으로 남기고 직전 문의에서 1분이 지나야 한다(쓰기 한도 소진 방지).
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid &&
        request.resource.data.keys().hasOnly(['uid', 'nickname', 'content', 'status', 'reply', 'repliedAt', 'createdAt', 'type', 'trainerId']) &&
        // [2026-11-01] B33: PT 상담 신청(type 'pt' + 트레이너 프로필 ID)
        request.resource.data.get('type', '') in ['', 'pt'] &&
        request.resource.data.get('trainerId', '') is string && request.resource.data.get('trainerId', '').size() <= 40 &&
        request.resource.data.content is string && request.resource.data.content.size() >= 1 && request.resource.data.content.size() <= 2000 &&
        nameOk(request.resource.data.get('nickname', '')) &&
        request.resource.data.status == '대기' && request.resource.data.reply == '' &&
        request.resource.data.get('repliedAt', null) == null &&
        request.resource.data.get('createdAt', null) == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('lastInquiryAt', null) == request.time &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('lastInquiryAt', null) == null ||
          request.time > get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastInquiryAt + duration.value(1, 'm'));
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      // [2026-10-31] 본인 문의 또는 관리자 삭제 허용(테스트 문의 정리 등)
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // [2026-10-31 Phase2 P2-2] connections/{trainerUid_memberUid} - 트레이너–회원 연결. 생성·재활성은 관리자,
    // 종료(status 'ended')는 관리자·당사자(트레이너/회원) 모두 가능, 읽기는 관리자·당사자.
    // [2026-10-31] 앱 설정 - 읽기 로그인 사용자, 쓰기 관리자
    match /settings/{sid} {
      allow read: if request.auth != null;
      // [2026-11-01] B16: 대시보드 기준값(운동 없음 일수·PT 적음 횟수·만료 임박 일수) 정수 1~365
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['ptDeductEnabled', 'noshowPolicy', 'updatedAt', 'staleDays', 'ptLowCount', 'expireSoonDays', 'riskAwayDays', 'riskHighDays', 'gymEquip', 'appMode', 'membershipExternal']) &&
        gymEquipOk() && appModeOk() &&
        settingNumOk('staleDays') && settingNumOk('ptLowCount') && settingNumOk('expireSoonDays') && settingNumOk('riskAwayDays') && settingNumOk('riskHighDays');
    }
    // [2026-11-13] 앱 운영 방식: 일반형이면 가입 즉시 승인(가입할 때 한 번만 읽음)
    function openSignupOk() {
      return exists(/databases/$(database)/documents/settings/app) &&
        get(/databases/$(database)/documents/settings/app).data.get('appMode', 'gym') == 'open';
    }
    function appModeOk() {
      let d = request.resource.data;
      return (!('appMode' in d) || d.appMode in ['gym', 'open']) &&
        (!('membershipExternal' in d) || d.membershipExternal is bool);
    }
    // [2026-11-13] 센터 보유 기구: 종류(12 이하)·머신·유산소 종목 이름(60 이하) 목록
    function gymEquipOk() {
      let d = request.resource.data;
      return !('gymEquip' in d) || (d.gymEquip is map && d.gymEquip.keys().hasOnly(['kinds', 'items']) &&
        d.gymEquip.get('kinds', []) is list && d.gymEquip.get('kinds', []).size() <= 12 &&
        d.gymEquip.get('items', []) is list && d.gymEquip.get('items', []).size() <= 60);
    }
    function settingNumOk(k) {
      return !(k in request.resource.data) ||
        (request.resource.data[k] is int && request.resource.data[k] >= 1 && request.resource.data[k] <= 365);
    }
    // [2026-10-31] PT 차감 기록 - 담당 트레이너가 생성(설정 켬)·되돌리기(삭제), 당사자·관리자 읽기
    // [2026-11-01] S1: 트레이너의 기록 생성·삭제는 같은 일괄 쓰기에서 회원 ptRemaining이 -1·+1 되고 users.ptSessionRef가 이 기록일 때만
    function ptPairOk(memberUid, sid, delta) {
      let before = get(/databases/$(database)/documents/users/$(memberUid)).data;
      let after = getAfter(/databases/$(database)/documents/users/$(memberUid)).data;
      return after.get('ptRemaining', 0) == before.get('ptRemaining', 0) + delta && after.get('ptSessionRef', '') == sid;
    }
    match /ptSessions/{sid} {
      allow read: if request.auth != null && (isAdmin() || resource.data.trainerUid == request.auth.uid || resource.data.memberUid == request.auth.uid);
      // [2026-11-01] B26: 회원 이름 스냅샷(memberName), B4: 남은 PT가 없을 때 '완료(미결제)'(unpaid: true)는 차감 없이 기록만
      allow create: if request.resource.data.trainerUid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['memberUid', 'trainerUid', 'trainerName', 'memberName', 'date', 'at', 'scheduleId', 'noshow', 'unpaid']) &&
        request.resource.data.date is string && request.resource.data.date.size() == 10 &&
        nameOk(request.resource.data.get('trainerName', '')) && nameOk(request.resource.data.get('memberName', '')) &&
        request.resource.data.get('at', null) == request.time &&
        isTrainerOf(request.resource.data.memberUid) &&
        ((request.resource.data.get('unpaid', false) == false && ptDeductEnabled() && ptPairOk(request.resource.data.memberUid, sid, -1)) ||
          (request.resource.data.get('unpaid', false) == true && request.resource.data.get('noshow', false) == false));
      // 관리자는 수동 정리를 위해 그대로 삭제 가능. 미결제 기록은 차감이 없어 트레이너가 그대로 지운다.
      allow delete: if isAdmin() || (resource.data.trainerUid == request.auth.uid && isTrainerOf(resource.data.memberUid) &&
        (resource.data.get('unpaid', false) == true || ptPairOk(resource.data.memberUid, sid, 1)));
      // [2026-11-01] B4: 관리자가 미결제 기록을 결제(차감) 처리 - 같은 일괄 쓰기에서 users.ptRemaining -1
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unpaid', 'settledAt']);
    }
    // [2026-10-31] PT 일정 - 담당 트레이너가 등록·완료·삭제, 당사자·관리자 읽기(회원 홈 캘린더 표시)
    match /ptSchedules/{sid} {
      allow read: if request.auth != null && (isAdmin() || resource.data.trainerUid == request.auth.uid || resource.data.memberUid == request.auth.uid);
      allow create: if request.resource.data.trainerUid == request.auth.uid && isTrainerOf(request.resource.data.memberUid) &&
        request.resource.data.keys().hasOnly(['memberUid', 'trainerUid', 'trainerName', 'memberName', 'date', 'time', 'status', 'createdAt']) &&
        request.resource.data.status == 'scheduled' &&
        nameOk(request.resource.data.get('trainerName', '')) && nameOk(request.resource.data.get('memberName', '')) &&
        request.resource.data.get('createdAt', null) == request.time &&
        request.resource.data.date is string && request.resource.data.date.size() == 10 &&
        request.resource.data.time is string && request.resource.data.time.size() <= 5;
      // 관리자는 일정 변경(status/trainerUid/trainerName/date/time 등) 그대로 가능
      // [2026-11-01] S16: 트레이너 수정은 날짜 10자·시간 5자 이하 형식, 완료 시각은 null 또는 서버 시각
      allow update: if isAdmin() || (resource.data.trainerUid == request.auth.uid && isTrainerOf(resource.data.memberUid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'doneAt', 'date', 'time']) &&
        request.resource.data.status in ['scheduled', 'done', 'noshow'] &&
        request.resource.data.date is string && request.resource.data.date.size() == 10 &&
        request.resource.data.time is string && request.resource.data.time.size() <= 5 &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['doneAt']) ||
          request.resource.data.doneAt == null || request.resource.data.doneAt == request.time));
      allow delete: if isAdmin() || (resource.data.trainerUid == request.auth.uid && isTrainerOf(resource.data.memberUid)) ||
        // [2026-11-01] B8: 회원이 담당 트레이너 연결을 직접 끊을 때(같은 일괄 쓰기에서 연결이 ended) 그 트레이너와의 '예정' 일정만 지운다
        (request.auth != null && resource.data.memberUid == request.auth.uid && resource.data.status == 'scheduled' &&
          getAfter(/databases/$(database)/documents/connections/$(resource.data.trainerUid + '_' + request.auth.uid)).data.status == 'ended');
    }
    // [2026-11-01] B19: 트레이너 회원별 메모 trainerNotes/{트레이너uid_회원uid} - 담당 트레이너(본인 메모)·관리자만, 1000자
    match /trainerNotes/{nid} {
      allow read, delete: if isAdmin() ||
        (request.auth != null && nid.split('_')[0] == request.auth.uid && isTrainerOf(nid.split('_')[1]));
      // 탈퇴하는 회원 본인: 탈퇴 표시(deletedAccounts)가 있을 때만 자기에 대한 메모 삭제(없는 문서 삭제도 허용됨)
      allow delete: if request.auth != null && nid.split('_')[1] == request.auth.uid &&
        exists(/databases/$(database)/documents/deletedAccounts/$(request.auth.uid));
      allow create, update: if request.auth != null &&
        request.resource.data.keys().hasOnly(['trainerUid', 'memberUid', 'text', 'updatedAt']) &&
        request.resource.data.trainerUid == request.auth.uid &&
        nid == request.auth.uid + '_' + request.resource.data.memberUid &&
        request.resource.data.text is string && request.resource.data.text.size() <= 1000 &&
        request.resource.data.updatedAt == request.time &&
        isTrainerOf(request.resource.data.memberUid);
    }
    // [2026-10-31] 운동 가이드 수정본 - 로그인 사용자 읽기, 트레이너·관리자 쓰기(필드 화이트리스트, 본인 이름으로 기록)
    match /exerciseGuides/{gid} {
      allow read: if request.auth != null;
      allow delete: if isStaff();
      allow create, update: if isStaff() &&
        request.resource.data.keys().hasOnly(['level', 'setup', 'start', 'move', 'breath', 'keyPoints', 'mistakes', 'cautions', 'alternatives', 'gymNote', 'updatedBy', 'updatedAt']) &&
        request.resource.data.updatedBy.uid == request.auth.uid &&
        request.resource.data.get('gymNote', '') is string && request.resource.data.get('gymNote', '').size() <= 300;
      // [2026-11-01] 수정 이력 - 트레이너·관리자만 읽기·추가, 수정·삭제 불가(필드 30개 이하)
      match /history/{hid} {
        allow read: if isStaff();
        allow create: if isStaff() && request.resource.data.keys().size() <= 30 &&
          request.resource.data.get('savedBy', {}).get('uid', '') == request.auth.uid &&
          request.resource.data.get('savedAt', null) == request.time;
        allow update, delete: if false;
      }
    }
    // [2026-10-31] 트레이너 프로필 - 로그인 사용자 읽기, 관리자 쓰기(사진 최대 3장: 기본은 /trainers/*.webp, 올린 사진은 줄인 data URL - 문서 1MB 한도)
    match /trainerProfiles/{pid} {
      allow read: if request.auth != null;
      allow write: if isAdmin() && (request.resource == null ||
        (request.resource.data.name is string && request.resource.data.name.size() <= 30 &&
          request.resource.data.get('photo', '') is string && request.resource.data.get('photo', '').size() <= 400000 &&
          request.resource.data.get('photos', []) is list && request.resource.data.get('photos', []).size() <= 3));
    }
    match /connections/{cid} {
      allow read: if isAdmin() ||
        (request.auth != null && (resource.data.trainerUid == request.auth.uid || resource.data.memberUid == request.auth.uid));
      allow create: if isAdmin() &&
        cid == request.resource.data.trainerUid + '_' + request.resource.data.memberUid &&
        request.resource.data.status == 'active' &&
        request.resource.data.keys().hasOnly(['trainerUid', 'memberUid', 'trainerName', 'memberName', 'memberNickname', 'status', 'startedAt', 'createdBy']);
      allow update: if (isAdmin() &&
          request.resource.data.trainerUid == resource.data.trainerUid &&
          request.resource.data.memberUid == resource.data.memberUid) ||
        (request.auth != null &&
          (resource.data.trainerUid == request.auth.uid || resource.data.memberUid == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt', 'endedBy']) &&
          request.resource.data.status == 'ended') ||
        // [2026-11-01] S22: 회원 본인은 탈퇴 때 연결을 종료하면서 이름·닉네임을 빈 값으로 지울 수 있다
        (request.auth != null && resource.data.memberUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt', 'endedBy', 'memberName', 'memberNickname']) &&
          request.resource.data.status == 'ended' &&
          request.resource.data.get('memberName', '') == '' && request.resource.data.get('memberNickname', '') == '');
      allow delete: if false;
    }

    // [2026-11-11] 앱 안 공지·만족도 설문(관리자 작성, 로그인 회원 읽기). 대상은 화면에서 거른다(all·pt·general·new).
    function noticeOk(d) {
      return d.keys().hasOnly(['kind', 'title', 'body', 'target', 'startDate', 'endDate', 'active', 'createdAt', 'createdBy', 'byName']) &&
        d.kind in ['notice', 'survey'] &&
        d.title is string && d.title.size() > 0 && d.title.size() <= 40 &&
        d.get('body', '') is string && d.get('body', '').size() <= 500 &&
        d.target in ['all', 'pt', 'general', 'new'] &&
        d.active is bool &&
        d.get('startDate', '') is string && d.get('startDate', '').size() <= 10 &&
        d.get('endDate', '') is string && d.get('endDate', '').size() <= 10 &&
        d.get('byName', '') is string && d.get('byName', '').size() <= 30;
    }
    match /notices/{nid} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin() && noticeOk(request.resource.data);
      allow delete: if isAdmin();
    }
    // 설문 응답: 회원 본인이 한 번만(문서 ID = 설문ID_uid), 0–10점 + 한 줄(200자), 수정 불가. 읽기는 관리자·본인
    match /surveyResponses/{rid} {
      allow read: if isAdmin() || (request.auth != null && (resource == null || resource.data.uid == request.auth.uid));
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['noticeId', 'uid', 'score', 'comment', 'at']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.noticeId is string && rid == request.resource.data.noticeId + '_' + request.auth.uid &&
        request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 10 &&
        request.resource.data.get('comment', '') is string && request.resource.data.get('comment', '').size() <= 200 &&
        request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // [2026-10-31] 관리자 대시보드 확장 - 메모·재등록 연락(관리자만, 회원 본인도 못 봄)
    match /adminNotes/{uid} {
      allow read, write: if isAdmin();
    }
    // 관리 이력 - 관리자만 생성(본인 이름으로)·조회, 수정·삭제 불가
    match /adminLogs/{lid} {
      allow read: if isAdmin();
      // 모든 기록은 서버 시각(at == request.time)으로만 - 미래 시각으로 목록을 밀어내는 것 방지
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['at', 'byUid', 'byName', 'action', 'targetUid', 'targetName', 'detail']) &&
        request.resource.data.at == request.time &&
        request.resource.data.detail is string && request.resource.data.detail.size() <= 300 &&
        ((isAdmin() && request.resource.data.byUid == request.auth.uid) ||
          // [2026-10-31] 담당 트레이너의 PT 작업 - 작성자 이름은 본인 이름, 회원 이름은 연결 문서의 이름과 같아야 함(다른 이름으로 꾸미기 방지)
          // [2026-11-01] 계획(plan)·목표(goal)도 같은 조건으로 트레이너가 남길 수 있다
          (request.resource.data.action in ['pt', 'plan', 'goal'] && request.resource.data.byUid == request.auth.uid &&
            isTrainerOf(request.resource.data.targetUid) &&
            request.resource.data.byName in [
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('signupInfo', {}).get('name', ''),
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('nickname', '')] &&
            request.resource.data.targetName == get(/databases/$(database)/documents/connections/$(request.auth.uid + '_' + request.resource.data.targetUid)).data.memberName) ||
          // [2026-11-01] 트레이너의 운동 가이드 수정(guide) - 대상 회원 없음(targetName에는 종목명 40자 이하)
          (request.resource.data.action == 'guide' && request.resource.data.byUid == request.auth.uid &&
            trainerRoleOk(get(/databases/$(database)/documents/users/$(request.auth.uid)).data) &&
            request.resource.data.byName in [
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('signupInfo', {}).get('name', ''),
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('nickname', '')] &&
            request.resource.data.targetUid == '' &&
            request.resource.data.targetName is string && request.resource.data.targetName.size() <= 40) ||
          // 탈퇴: 누가 탈퇴했는지 남기지 않는다(작성자·대상 모두 빈 값). 가입된 회원만(사용자 문서 삭제 전에 씀).
          // [2026-11-01] S7: 탈퇴 표시(deletedAccounts)를 처음 만드는 같은 일괄 쓰기에서만(반복 생성 방지)
          (request.resource.data.action == 'withdraw' && request.resource.data.byUid == '' && request.resource.data.byName == '' &&
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            !exists(/databases/$(database)/documents/deletedAccounts/$(request.auth.uid)) &&
            existsAfter(/databases/$(database)/documents/deletedAccounts/$(request.auth.uid)) &&
            request.resource.data.targetUid == '' && request.resource.data.targetName == '' && request.resource.data.detail == '회원 1명 탈퇴') ||
          // [2026-11-01] B8: 회원이 담당 트레이너 연결을 직접 해제 - 본인 uid만, 이름 없이, 짧은 내용
          (request.resource.data.action == 'disconnect' && request.resource.data.byUid == request.auth.uid &&
            request.resource.data.targetUid == request.auth.uid && request.resource.data.byName == '' &&
            request.resource.data.targetName == '' && request.resource.data.detail.size() <= 60));
      allow update: if false;
      // [2026-11-01] B3: 보존 기간(2년)이 지난 이력만 관리자가 지울 수 있다
      allow delete: if isAdmin() && resource.data.at < request.time - duration.value(730, 'd');
    }
    // 익명 이용 집계(주별 요일·시간대 운동 시작 횟수, 개인 정보 없음) - 승인 회원이 운동 저장 때 +1, 관리자만 조회
    // [2026-11-01] S8: hours·days는 hk·dk에 적은 칸 하나만 +1(맵 통째 덮어쓰기 방지)
    function statOk(m, o, k) {
      return m is map && k is string && k.size() >= 1 && k.size() <= 2 &&
        m.diff(o).affectedKeys().hasOnly([k]) && m[k] == o.get(k, 0) + 1;
    }
    match /gymStats/{wk} {
      allow read: if isAdmin();
      allow create: if isApproved() && request.resource.data.keys().hasOnly(['sessions', 'hours', 'days', 'hk', 'dk']) &&
        request.resource.data.sessions == 1 &&
        statOk(request.resource.data.get('hours', {}), {}, request.resource.data.get('hk', '')) &&
        statOk(request.resource.data.get('days', {}), {}, request.resource.data.get('dk', ''));
      allow update: if isApproved() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sessions', 'hours', 'days', 'hk', 'dk']) &&
        request.resource.data.sessions == resource.data.get('sessions', 0) + 1 &&
        statOk(request.resource.data.get('hours', {}), resource.data.get('hours', {}), request.resource.data.get('hk', '')) &&
        statOk(request.resource.data.get('days', {}), resource.data.get('days', {}), request.resource.data.get('dk', ''));
      allow delete: if false;
    }

    // Phase2 이후 컬렉션(roleRequests, programs,
    // feedback, messages, diet)은 아직 화면/로직이 없으므로 기본 거부.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
