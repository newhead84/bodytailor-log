rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // [2026-07-31 신규] 문의(inquiries) 관리자 판별 헬퍼: 요청자 본인의 users/{uid} 문서에서
    // role 필드를 읽어 '관리자'인지 확인한다.
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == '관리자'
    }

    // [2026-10-27 W0 보안강화] 본인이 자기 문서에서 권한/등급 필드를 직접 바꾸는 것을 막는다.
    // 이전에는 본인 문서 전체 쓰기를 허용해 role:'관리자'를 스스로 넣으면 isAdmin()을 통과하는
    // 권한 상승이 가능했다. role/roleRequestStatus/tier/lifetimeBadges/trainerProfile은
    // 콘솔(관리자) 또는 추후 서버 로직에서만 변경한다.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // [2026-10-31 Phase2 P2-1] 헬스장 회원 승인 필드(memberStatus 등)도 본인은 변경 불가 — 관리자만
    function lockedUserKeys() {
      return ['role', 'roleRequestStatus', 'tier', 'lifetimeBadges', 'trainerProfile',
        'memberStatus', 'approvedAt', 'approvedBy', 'memberNo', 'rosterId', 'statusUpdatedAt'];
    }
    // 관리자가 다른 회원 문서에서 바꿀 수 있는 필드
    function adminUserKeys() {
      return ['role', 'memberStatus', 'approvedAt', 'approvedBy', 'memberNo', 'rosterId', 'statusUpdatedAt'];
    }
    // [2026-10-31 Phase2 P2-1] 승인된 회원만 기록·루틴·랭킹을 쓸 수 있다.
    // memberStatus가 없는 기존 계정은 승인으로 간주, 관리자는 항상 허용.
    function isApproved() {
      let d = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null && (d.get('memberStatus', 'approved') == 'approved' || d.get('role', '') == '관리자');
    }
    // 세션 1회 XP 상한(storage.js computeSessionXp 최대 180) — 여유분 포함 200
    // [2026-10-29] 자동 저장 "되돌리기"로 XP를 빼야 해서 감소도 1회 200까지 허용(0 미만 불가).
    function xpDeltaOk(field) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is number &&
         request.resource.data[field] >= 0 &&
         request.resource.data[field] - resource.data.get(field, 0) >= -200 &&
         request.resource.data[field] - resource.data.get(field, 0) <= 200);
    }
    // 시즌이 바뀐 첫 저장에서는 seasonXp가 새 시즌 값(0~200)으로 리셋될 수 있다.
    function seasonXpOk() {
      return xpDeltaOk('seasonXp') ||
        (request.resource.data.get('seasonKey', null) != resource.data.get('seasonKey', null) &&
         request.resource.data.seasonXp is number &&
         request.resource.data.seasonXp >= 0 && request.resource.data.seasonXp <= 200);
    }

    // users/{uid} — 본인 문서만 읽기/쓰기(권한 필드·XP 증가폭 제한)
    // [2026-10-31 Phase2 P2-1] 관리자는 전체 회원 읽기 + 승인·역할 필드만 수정. 새 계정은 승인 대기(pending)로만 생성.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) &&
        request.resource.data.get('role', '일반회원') == '일반회원' &&
        request.resource.data.get('roleRequestStatus', 'none') == 'none' &&
        request.resource.data.get('memberStatus', '') == 'pending' &&
        request.resource.data.get('tier', 'iron') == 'iron' &&
        request.resource.data.get('lifetimeBadges', []).size() == 0 &&
        request.resource.data.get('trainerProfile', null) == null &&
        !request.resource.data.keys().hasAny(['approvedAt', 'approvedBy', 'memberNo', 'rosterId', 'statusUpdatedAt']) &&
        request.resource.data.get('seasonXp', 0) == 0 &&
        request.resource.data.get('lifetimeXp', 0) == 0;
      allow update: if (isOwner(uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(lockedUserKeys()) &&
          seasonXpOk() && xpDeltaOk('lifetimeXp')) ||
        (isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(adminUserKeys()) &&
          request.resource.data.get('role', '일반회원') in ['일반회원', 'PT회원', '트레이너', '관리자'] &&
          request.resource.data.get('memberStatus', 'approved') in ['pending', 'approved', 'rejected', 'expired'] &&
          (uid != request.auth.uid || request.resource.data.get('role', '') == '관리자'));
      allow delete: if false;
    }

    // [2026-10-31 Phase2 P2-1] gymRoster/{rosterId} — 헬스장 출입관리 명단 이관본(이름·전화 해시·뒤 4자리·회원번호·만료일). 관리자만.
    match /gymRoster/{rosterId} {
      allow read, write: if isAdmin();
    }

    // routineTemplates/{uid}/templates/{templateId} — 본인 소유 서브컬렉션
    // [2026-10-31 Phase2 P2-2/P2-3] 담당 트레이너(활성 연결 + 트레이너 역할) 판정
    function isTrainerOf(memberUid) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/connections/$(request.auth.uid + '_' + memberUid)) &&
        get(/databases/$(database)/documents/connections/$(request.auth.uid + '_' + memberUid)).data.status == 'active' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == '트레이너';
    }
    // [2026-10-31 P2-3] 담당 트레이너는 회원 루틴을 읽고, 자기 이름(byTrainer.uid)으로 만든 계획만 생성·수정·삭제한다.
    function trainerPlanOk() {
      return request.resource.data.keys().hasOnly(['title', 'parts', 'note', 'byTrainer', 'order', 'createdAt', 'updatedAt']) &&
        request.resource.data.byTrainer.keys().hasOnly(['uid', 'name']) &&
        request.resource.data.byTrainer.uid == request.auth.uid &&
        request.resource.data.title is string && request.resource.data.title.size() <= 40 &&
        request.resource.data.parts is list && request.resource.data.parts.size() <= 7 &&
        request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 300;
    }
    match /routineTemplates/{uid}/templates/{templateId} {
      allow read: if request.auth != null && (request.auth.uid == uid || isTrainerOf(uid));
      allow write: if request.auth != null && request.auth.uid == uid && isApproved();
      allow create: if isTrainerOf(uid) && trainerPlanOk();
      allow update: if isTrainerOf(uid) && resource.data.get('byTrainer', {}).get('uid', '') == request.auth.uid && trainerPlanOk();
      allow delete: if isTrainerOf(uid) && resource.data.get('byTrainer', {}).get('uid', '') == request.auth.uid;
    }

    // [2026-10-27 신규] activeSessions/{uid} — 진행 중 운동 세션 서버 백업(본인만, 크기 제한)
    match /activeSessions/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isApproved() &&
        request.resource.data.keys().hasOnly(['draft', 'updatedAt']) &&
        request.resource.data.draft is string && request.resource.data.draft.size() < 200000;
    }

    // workoutLogs/{uid}/logs/{logId} — 본인 소유 서브컬렉션
    // [2026-10-31 Phase2 P2-2] 담당 트레이너(isTrainerOf)는 그 회원의 운동 기록을 읽을 수 있다(쓰기 불가).
    match /workoutLogs/{uid}/logs/{logId} {
      allow read: if request.auth != null && (request.auth.uid == uid || isTrainerOf(uid));
      allow write: if request.auth != null && request.auth.uid == uid && isApproved();
    }

    // leaderboard/{group}/{period}/{uid}
    // 랭킹은 로그인한 모든 사용자가 열람 가능(전체 랭킹 노출 목적),
    // 쓰기는 본인 문서만 허용. 부정 점수 조작 방지가 중요해지면
    // 이 쓰기 권한은 Cloud Functions 전용으로 옮기고 클라이언트 쓰기를 막는 것을 권장.
    // [2026-10-27 W0] 필드 화이트리스트 + 점수 범위(0~200) 검증. 완전한 조작 방지는 서버 계산이
    // 필요하지만(무료 플랜 유지 결정), 비정상 값(예: 99999점) 기록은 규칙에서 거부한다.
    function scoreOk(k) {
      return !(k in request.resource.data) ||
        (request.resource.data[k] is number && request.resource.data[k] >= 0 && request.resource.data[k] <= 200);
    }
    match /leaderboard/{group}/{period}/{uid} {
      allow read: if request.auth != null;
      allow write: if isOwner(uid) && isApproved() &&
        request.resource.data.keys().hasOnly(['nickname', 'baseScore', 'attendanceScore', 'volumeScore',
          'overloadScore', 'streakBonus', 'programComplianceBonus', 'finalScore', 'updatedAt']) &&
        (!('nickname' in request.resource.data) ||
          (request.resource.data.nickname is string && request.resource.data.nickname.size() <= 30)) &&
        scoreOk('baseScore') && scoreOk('attendanceScore') && scoreOk('volumeScore') &&
        scoreOk('overloadScore') && scoreOk('streakBonus') && scoreOk('programComplianceBonus') &&
        scoreOk('finalScore');
    }

    // exercisePopularity/{atom} — 개인정보 없는 부위별 종목 수행 횟수 공개 집계(⑨).
    // 로그인한 모든 사용자가 열람 가능(리포트 탭 "다른 유저 즐겨찾는 운동" 노출 목적).
    // 쓰기(카운트 증가)도 로그인 사용자면 가능 — 개인 식별 정보가 없는 집계 수치라
    // leaderboard처럼 본인 uid로 제한할 필요가 없다. 악의적 대량 조작 우려가 커지면
    // Cloud Functions 전용 쓰기로 옮기는 것을 권장(leaderboard와 동일한 원칙).
    // [2026-10-27 W0] counts 맵 외 필드 쓰기 금지 + 한 번에 바뀌는 종목 수 제한, 삭제 금지.
    match /exercisePopularity/{atom} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isApproved() && request.resource.data.keys().hasOnly(['counts']) &&
        request.resource.data.counts is map && request.resource.data.counts.size() <= 30;
      allow update: if request.auth != null && isApproved() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counts']) &&
        request.resource.data.counts.diff(resource.data.get('counts', {})).affectedKeys().size() <= 30 &&
        request.resource.data.counts.diff(resource.data.get('counts', {})).removedKeys().size() == 0;
      allow delete: if false;
    }

    // inquiries/{inquiryId} — MY탭 1:1 문의(⑩). 본인은 작성 + 본인 문의만 열람 가능.
    // 관리자(role === '관리자')는 전체 열람 + 답변(reply/status) 수정 가능. uid/content는
    // 작성자 본인도 수정 불가(문의 내용 위변조 방지, 답변만 관리자가 갱신).
    match /inquiries/{inquiryId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid &&
        request.resource.data.content is string && request.resource.data.content.size() <= 2000 &&
        request.resource.data.status == '대기' && request.resource.data.reply == '';
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    // [2026-10-31 Phase2 P2-2] connections/{trainerUid_memberUid} — 트레이너–회원 연결. 생성·재활성은 관리자,
    // 종료(status 'ended')는 관리자·당사자(트레이너/회원) 모두 가능, 읽기는 관리자·당사자.
    match /connections/{cid} {
      allow read: if isAdmin() ||
        (request.auth != null && (resource.data.trainerUid == request.auth.uid || resource.data.memberUid == request.auth.uid));
      allow create: if isAdmin() &&
        cid == request.resource.data.trainerUid + '_' + request.resource.data.memberUid &&
        request.resource.data.status == 'active' &&
        request.resource.data.keys().hasOnly(['trainerUid', 'memberUid', 'trainerName', 'memberName', 'memberNickname', 'status', 'startedAt', 'createdBy']);
      allow update: if (isAdmin() &&
          request.resource.data.trainerUid == resource.data.trainerUid &&
          request.resource.data.memberUid == resource.data.memberUid) ||
        (request.auth != null &&
          (resource.data.trainerUid == request.auth.uid || resource.data.memberUid == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt', 'endedBy']) &&
          request.resource.data.status == 'ended');
      allow delete: if false;
    }

    // Phase2 이후 컬렉션(roleRequests, programs,
    // feedback, messages, diet)은 아직 화면/로직이 없으므로 기본 거부.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
